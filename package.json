{
  "name": "merceria-crm-root",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Gestión de Stock y Ventas para Trazos Librería",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --prefix \"[{name}]\" --names \"frontend,backend\" -c \"cyan.bold,green.bold\" \"pnpm --filter frontend dev\" \"pnpm run dev:backend\"",
    "dev:backend": "node ./scripts/run-backend.js",
    "dev:frontend": "pnpm --filter frontend dev",
    "migrate": "node ./scripts/run-migrations.js",
    "migrate:status": "node ./scripts/run-migrations.js --check",
    "admin:create": "node ./scripts/create-admin.js",
    "data:cleanup-legacy": "node ./scripts/cleanup-legacy-data.js",
    "test:backend": "node ./scripts/run-backend-tests.js",
    "test:frontend": "pnpm --filter frontend test",
    "build": "pnpm --filter frontend build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
