# =====================================================================
# Configuración del Entorno - CRM Mercería
# Copiar este archivo como .env y completar los valores reales.
# NUNCA subir el archivo .env al repositorio ni compartir el token.
# =====================================================================

# Base de datos Turso (libSQL)
TURSO_DATABASE_URL=libsql://merceriadb-guillermo-costilla.aws-us-east-1.turso.io
TURSO_AUTH_TOKEN=tu_token_de_turso_aqui

# Seguridad y Autenticación
# Generar una clave segura aleatoria (ej: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=cambiar_por_clave_secreta_aleatoria_de_32_bytes_en_produccion
SESSION_EXPIRE_HOURS=12

# Entorno de ejecución (development | production)
ENVIRONMENT=development

# Configuración CORS y Frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Parámetros del negocio y localización
BUSINESS_TIMEZONE=America/Argentina/Tucuman
BUSINESS_CURRENCY=ARS

# Configuración de Correo Electrónico (Recuperación de Contraseña)
# En desarrollo, si está vacío, los enlaces se imprimen de forma segura en la consola del servidor
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=notificaciones@merceria.local
